{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truco-api",
  "main": "worker.mjs",
  "account_id": "acaa540644beaee202d4ca472b5975ac",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BACKEND_ORIGIN": "https://api-truco-to-three.onrender.com",
    "ALLOWED_ORIGINS": "https://ezevillo.com,https://www.ezevillo.com,https://localhost,capacitor://localhost"
  },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "88301001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "88301002", "simple": { "limit": 10, "period": 60 } },
    { "name": "REGISTER_LIMITER", "namespace_id": "88301003", "simple": { "limit": 5, "period": 60 } },
    { "name": "GUEST_LIMITER", "namespace_id": "88301004", "simple": { "limit": 10, "period": 60 } },
    { "name": "REFRESH_LIMITER", "namespace_id": "88301005", "simple": { "limit": 60, "period": 60 } },
    { "name": "CONNECTION_LIMITER", "namespace_id": "88301006", "simple": { "limit": 20, "period": 60 } }
  ]
}
